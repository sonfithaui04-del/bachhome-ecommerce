# Mẫu biến môi trường của BachHome.
# Chép file này thành .env rồi điền giá trị thật. File .env đã được .gitignore,
# không bao giờ đẩy lên kho mã nguồn.

# ---- Trợ lý ảo (Google Gemini) ----
# Lấy khoá tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Tài khoản nhận tiền cho mã QR thanh toán ----
# Mã ngân hàng dùng theo tên SePay quy ước, VD: Vietcombank, MBBank, TPBank, ACB.
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=Vietcombank
SEPAY_ACCOUNT_NAME=
